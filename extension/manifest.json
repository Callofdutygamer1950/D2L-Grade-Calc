{
  "manifest_version": 3,
  "name": "Grade Calculator for D2L",
  "short_name": "Grade Calc",
  "version": "1.0.0",
  "description": "Shows your overall course grade at the top of the D2L Brightspace Grades page, using weights you set or pull from your syllabus.",
  "homepage_url": "https://github.com/Callofdutygamer1950/D2L-Grade-Calc",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://chhfebjnwftjyogxyzcx.supabase.co/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.desire2learn.com/d2l/lms/grades/my_grades/*",
        "https://*.brightspace.com/d2l/lms/grades/my_grades/*"
      ],
      "js": ["grades-core.js", "grouping.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "grade-calculator-for-d2l@callofdutygamer1950",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
